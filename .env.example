# ==============================================================================
# SAATHI-AI Environment Configuration Template
# Copy this file to .env and fill in the values before running services.
# ==============================================================================

# --- System / General ---
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production

# --- Database (PostgreSQL) ---
POSTGRES_USER=saathi
POSTGRES_PASSWORD=saathi_password
POSTGRES_DB=saathi_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://saathi:saathi_password@localhost:5432/saathi_db
DATABASE_SYNC_URL=postgresql://saathi:saathi_password@localhost:5432/saathi_db

# --- Cache / Queue (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Object Storage (MinIO / S3) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_AUDIO=saathi-audio
MINIO_BUCKET_REPORTS=saathi-reports
MINIO_USE_SSL=false

# --- Real-Time Communication (LiveKit) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- AI / Generative Models ---
# Google Gemini API Key for explanation drafting & conversational assistance
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_LIVE_MODEL=gemini-2.0-flash

# --- Hugging Face (Optional) ---
# HF_TOKEN=your_hugging_face_token_here

# --- Authentication & JWT ---
JWT_SECRET_KEY=change-me-to-a-secure-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
